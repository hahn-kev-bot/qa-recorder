{
  "name": "qa-recorder",
  "version": "0.3.1",
  "description": "Record QA sessions of any app or website with a feedback toolbar, and hand the notes to a coding agent.",
  "repository": {
    "type": "git",
    "url": "https://github.com/hahn-kev-bot/qa-recorder"
  },
  "homepage": "https://github.com/hahn-kev-bot/qa-recorder#readme",
  "license": "MIT",
  "author": "Kevin Hahn",
  "type": "module",
  "main": "src/gui/main.cjs",
  "bin": {
    "qa-recorder": "src/cli.mjs"
  },
  "scripts": {
    "gui": "node src/cli.mjs gui",
    "start": "node src/cli.mjs gui",
    "test": "node --test test/unit/*.test.mjs",
    "check": "node test/check.mjs",
    "smoke:url": "node test/smoke-url.mjs",
    "smoke:gui": "node test/smoke-gui.mjs",
    "smoke:fwlite": "node test/smoke-fwlite.mjs",
    "smoke:dogfood": "node test/smoke-dogfood.mjs",
    "smoke:voice": "node test/smoke-voice.mjs",
    "dist": "electron-builder --win --publish never"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "ajv": "^8.20.0",
    "electron-updater": "^6.8.11",
    "playwright-core": "^1.56.0"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "io.github.hahn-kev-bot.qa-recorder",
    "productName": "QA Recorder",
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**",
      "configs/**",
      "!configs/qa-recorder.json",
      "schema/**",
      "assets/**",
      "AUTHORING.md",
      "README.md",
      "LICENSE",
      "package.json",
      "!node_modules/onnxruntime-node/bin/napi-v*/{darwin,linux}/**",
      "!node_modules/onnxruntime-node/bin/napi-v*/win32/arm64/**",
      "!node_modules/onnxruntime-web/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "QA-Recorder-Setup-${version}.${ext}",
      "shortcutName": "QA Recorder"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "hahn-kev-bot",
        "repo": "qa-recorder",
        "releaseType": "draft"
      }
    ]
  }
}
